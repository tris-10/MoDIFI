params {
        // main
        resources_dir="${projectDir}/resources"
        output_dir="${projectDir}/output/MoDIFI_TEST"
	temp_dir="${output_dir}/temp"
	script_dir="${projectDir}/scripts"
	SampleInfo = "${resources_dir}/SampleInfo.tsv"
        SamplePair = "${resources_dir}/SamplePair.tsv"
	prior_file = "${resources_dir}/Gnocchi.tsv"
	promoterFilePath = "${resources_dir}/Promoter/Promoter.tsv"
	// DATA: ATAC-seq
	ATACBAMFiles=[
	"IMR90":"${resources_dir}/imr90/atac_seq/bam/*.bam",
	"GM12878":"${resources_dir}/gm12878/atac_seq/bam/*.bam"
	]
	ATACBEDFile=[
	"IMR90":"${resources_dir}/imr90/atac_seq/*.bed.gz",
	"GM12878":"${resources_dir}/gm12878/atac_seq/*.bed.gz"
	]
	// DATA: RNA-seq
        RNACountFile=[
	"IMR90":"${resources_dir}/imr90/rna_seq/*.tsv",
	"GM12878":"${resources_dir}/gm12878/rna_seq/*.tsv"
	]
	// DATA: Hi-C
	HiCLoopsFile=[
	"IMR90":"${resources_dir}/imr90/hic/*.bedpe.gz",
	"GM12878":"${resources_dir}/gm12878/hic/*.bedpe.gz"
	]

	// Paramter: ATAC-seq
        ATACSeq='ATACseq'      //Labels for DEseq outputs
		atac_peak_minQ=5       //narrowPeak-derived peak quality threshold
        atac_mapq_minQ=5       //BAM read mapping quality threshold
        ATAC_Key_col='Region'  // The main column for DEseq analysis
        atac_merge_rule = "min" // take {min, max, mean, or median} for merged ATAC-seq regions
		
    //Parameter: RNA-seq
        RNASeq='RNAseq'        //Labels for DEseq outputs
        RNA_Key_col='GeneID'   // The main column for DESeq2 analysis
        RNA_ANN_File="${resources_dir}/hg38_annotation.txt"
        RNA_quantification='expected_count'
		bacon_seed=1234
        singularity_cache = "${projectDir}"
        modifi_container = "${projectDir}/modifi.sif"

}

process {
   executor = "slurm"
   errorStrategy = 'finish'
   clusterOptions = "--mail-user <your_email> --mail-type FAIL"

   withName: MapATACWithHiCWithPRO{
      memory = 24.GB
      maxForks = 4
      cpus = 3
   }
   withName: AdjustZInflation{
      memory = 24.GB
      maxForks = 4
      cpus = 3
   }
   withName: calMoDIFY{
      memory = 24.GB
      maxForks = 4
      cpus = 3
   }
   withName: runDEseq{
      memory = 24.GB
      maxForks = 4
      cpus = 3
   }
}


singularity {
    enabled = true
    autoMounts = true
    cacheDir = params.singularity_cache
    runOptions = "-B <path_to_your_working_dir>"
}

